# URL pública da API, sem /api/v1 no final.
# Emulador Android: http://10.0.2.2:3333 · Celular físico: http://IP-DO-SEU-PC:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# URL do frontend web. Precisa estar em CORS_ORIGINS no backend:
# o app a envia como Origin e a usa no link "Cadastre seu negócio".
EXPO_PUBLIC_WEB_URL=http://localhost:3000
